;;; -*- Mode: Lisp; -*-
;;; express.abclr2
;;; Definitions of the metaobject/evaluator for express messages
;;; Jul. 19, 1992 by MASUHARA, H.
;;; Jul. 25, 1992 --- modified according to the change of script specification
;;; Nov. 17, 1992 --- a new approach to grab executing expression.

;; A metaobject of an object that can accept express type messages is
;; created by meta/express-gen.
;; An express type message is sent by following form:
;;	[target <= message :express], or
;;	[target <== message :express]
;; This form must be evaluated by eval/express. In other words, an object
;; that sends express type messages must be a member of a group having
;; eval/express as an evaluator.
;; A script invoked by an express message is executed without queuing.
;; Since normal script execution is not preempted, however, the user
;; should surround the critical section by (atomic ...) form.

(provide 'express)

#|;; This definition is moved to src/user.lsp.
(defmacro atomic (&rest body)
  "evaluates body expressions with a guarantee that the evaluation
is not took place with other atomic form simulataneously."
  (let ((result (gensym)))
    `(let ((,result (progn
		      (bracket (bracket meta me) <== :lock)
		      ,@body)))
      (bracket (bracket meta me) <= :release)
      ,result)))
|#

;;; Metaobject generator for objects receiving express-type messages.
[object meta/express-gen
  (meta-gen non-reifying-meta)
  (script
   (=> [:new StateSpec LexEnv Scripts Eval GMgr] @ R
       (temporary front-eval)
       ;; Customized evaluator is created.
       ;; [eval/express := [eval/express-gen <== [:new Eval]]]
       [front-eval := [eval-front-gen <== [:new Eval]]]
       (let ((scriptSet scripts)
	     (Group-manager GMgr)
	     (evaluator front-eval)
	     dispatcher)
	 ;;
	 ;; Message dispatcher
	 ;;
	 [object dispatcher
	   (meta-gen non-reifying-meta)
	   (state [state := nil])
	   (script
	    (=> [:dispatch Message Reply Sender :Me meta/express] @ notifyEnd
		(match (find-script Message Reply Sender scriptSet)
		  (is [Bindings ScriptBody]
		      [evaluator 
		       <= [:do
			   ScriptBody
			   [env-gen <== [:new Bindings state]]
			   Meta/express Group-manager evaluator]
		       @ notifyEnd])
		  (otherwise
		   (warn "~S cannot handle the message ~S"
			 [den Me] Message))))
	    (=> [:set-state s] [state := s]))]
	 ;;
	 ;; The metaobject receiving express messages
	 ;;
	 [object Metaobject/express
	   (meta-gen non-reifying-meta)
	   (state [queue := [queue-gen <== :new]]
		  [mode := ':dormant]
		  [express-queue := [queue-gen <== :new]]
		  [hanging-context := nil]
		  [state-before-lock := nil])
	   (script
	    ;; Normal message
	    (=> [:message Message Reply Sender]
		(case mode
		  (:dormant
		   [mode := ':active]
		   [dispatcher <= [:dispatch Message Reply Sender :Me Me]
			       @ [cont _ [Me <= :end]]])
		  ((:active :express :lock)
		   [queue <= [:enq [Message Reply Sender]]])))
	    ;; End of script execution
	    (=> :end
		(if (not [express-queue <== :empty?])
		    ;; Accept a queued express message (which
		    ;; might come during the express mode) if exists.
		    (progn
		      [mode := ':express]
;; PORT-BEGIN: Dequeue and bind this envelope before dispatch; preserve queue policy.
;;|		      [dispatcher <= [:dispatch Message Reply Sender :Me Me]
;;|				  @ [cont _ [Me <= :end]]])
;; PORT-ACTIVE
		      (match [express-queue <== :deq]
			(is [Message Reply Sender]
			    [dispatcher <= [:dispatch Message Reply Sender :Me Me]
					@ [cont _ [Me <= :end]]])))
;; PORT-END
		    ;; Resume preempted execution.
		    (match hanging-context
		      (is [R . Context]
			  [mode := ':active]
			  [hanging-context := nil]
			  [evaluator <= [:do . Context] @ R])
		      (otherwise
		       ;; Accept a queued normal message.
		       (if (not [queue <== :empty?])
			   (progn
			     [mode := ':active]
;; PORT-BEGIN: Dequeue and bind this envelope before dispatch; preserve queue policy.
;;|			     [dispatcher
;;|			      <= [:dispatch Message Reply Sender :Me Me]
;;|			      @ [cont _ [Me <= :end]]])
;; PORT-ACTIVE
			     (match [queue <== :deq]
			       (is [Message Reply Sender]
				   [dispatcher
				    <= [:dispatch Message Reply Sender :Me Me]
				    @ [cont _ [Me <= :end]]])))
;; PORT-END
			   [mode := ':dormant])))))
	    ;; Express message
	    (=> [:message Message Reply Sender :express]
		(case mode
		  ;; An express message is accepted if the object is
		  ;; dormant. (No promblem!)
		  (:dormant
		   [mode := ':express]
		   [dispatcher <= [:dispatch Message Reply Sender :Me Me]
			       @ [cont _ [Me <= :end]]])
		  ;; When the object is active, i.e., executing a script 
		  ;; invoked by a normal message, the execution is 
		  ;; to be preempted.
		  (:active
		   [mode := ':express]
		   (match [evaluator <== :grab]
		     (is [:context R . Context]
			 [hanging-context := [R . Context]]
			 [dispatcher <= [:dispatch Message Reply Sender :Me Me]
				     @ [cont _ [Me <= :end]]])))
		  ;; Even express messages can't preempt an executing 
		  ;; script invoked by another express message.  Moreover,
		  ;; it can't preempt when the object is executing
		  ;; ATOMIC form.
		  ((:express :lock)
		   [express-queue <= [:enq [Message Reply Sender]]])))
	    ;; It is guaranteed that no lock request arrives when
	    ;; the object is already locked.
	    (=> :lock
		[state-before-lock := mode]
		[mode := ':lock]
		!:ok)
	    (=> :release
		;; unwind the state before locking
		[mode := state-before-lock]
		(when (and (eq mode ':active)
			   (not [express-queue <== :empty?]))
		  ;; Execute the express message arrived during the 
		  ;; object is locked.
		  [mode := ':express]
		  (match [[evaluator <== :grab] [express-queue <== :deq]]
		    (is [[:context R . Context] [Message Reply Sender]]
			[hanging-context := [R . Context]]
			[dispatcher <= [:dispatch Message Reply Sender :Me Me]
				    @ [cont _ [Me <= :end]]]))))
	    (=> [:set-state s] [dispatcher <= [:set-state s]])
	    )]
;; PORT-BEGIN: Set the known owner before initialization; NRM state remains opaque.
;; PORT-ACTIVE
	 (setf (r2sys::object-data-gid [den Metaobject/express]) GMgr)
;; PORT-END
	 [Eval <= [:do-evlis (stateSpec-initforms StateSpec)
		    LexEnv Metaobject/express GMgr Eval]
	       @ [cont initValues
		       [Metaobject/express
			<= [:set-state
			    [env-gen 
			     <== [:new (pairlis (stateSpec-varNames stateSpec)
						initValues)
				       LexEnv]]]]
		       [R <= Metaobject/express]]])))]

;;; Evaluator that can send express type message
[object eval/express-gen
  (meta-gen non-reifying-meta)
  (script
   (=> [:new original-eval]
       ![object eval/express
	  (meta-gen non-reifying-meta)
	  (script
	   ;; past type express messages
	   (=> [:do [:send-past Target Message Reply :express]
		    Env Id Gid Eval] @ C
		    [C <= nil]
		    (if (not (null Target))
			[[meta Target]
			 <= [:message Message Reply [den Id] :express]]))
	   ;; now type express messages
	   (=> [:do [:send-now Target Message :express]
		    Env Id Gid Eval] @ C
		    (if (not (null Target))
			[[meta Target]
			 <= [:message Message C [den Id] :express]]))
	   ;; other expressions are delegated
	   (=> any @ C
	       [original-eval <= any @ C])
	   )]))]

;;; An evaluator front-end that can preempt its execution, if
;;; requested.  For each metaobject that can receive express messages,
;;; this front-end object is created.
[object eval-front-gen
  (meta-gen non-reifying-meta)
  (script
   (=> [:new original-eval]
       ![object eval-front
	  (meta-gen non-reifying-meta)
	  (state [grab-request := nil]
		 [grab-reply-dest := nil]
		 )
	  (script
	   (=> [:do . Context] @ C
	       (if grab-request
		   (progn
		     [grab-request := nil]
		     [grab-reply-dest 
		      <= [:context C . context]])
		   [original-eval <= [:do . Context] @ C]))
	   (=> :grab @ R
	       [grab-request := t]
	       [grab-reply-dest := R])
	   (=> any @ R
	       [original-eval <= any @ R])
	   )]))]
