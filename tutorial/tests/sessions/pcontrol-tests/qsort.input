
(defun pc-check (name actual expected)
  (if (equal actual expected)
      (format t "~&PC-PASS ~A~%" name)
      (error "PC-FAIL ~A got ~S expected ~S" name actual expected)))

(inc "start" :use-source t)
(inc "qsort" :use-source t)
[input-array := (make-array 4 :initial-contents '(3 1 3 2))]
(pc-check "priority-sort" (coerce [test-pc <== [:start input-array 4]] 'list) '(1 2 3 3))
(pc-check "fifo-sort" (coerce [test-np <== [:start input-array 4]] 'list) '(1 2 3 3))
(pc-check "caller-array-unchanged" (coerce input-array 'list) '(3 1 3 2))

(format t "~&PC-END~%")
:q
