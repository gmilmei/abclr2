(defun tutorial-check (name actual expected)
  (if (equal actual expected)
      (format t "~&CHECK-PASS ~A~%" name)
      (error "CHECK-FAIL ~A: got ~S, expected ~S" name actual expected)))
(inc "build/tutorial-tests/05-reflection" :use-source t)
(tutorial-check "05-reflection-1" [observed-counter <== :inc] 1)
(tutorial-check "05-reflection-2" [[[meta observed-counter] <== :state] <== [:value-of 'n]] 1)
(tutorial-check "05-reflection-3" [[[meta observed-counter] <== :state] <== [:set 'n 40]] 40)
(tutorial-check "05-reflection-4" [observed-counter <== :inc] 41)
(tutorial-check "05-reflection-5" [choice-test <== [:choose 3]] 2)
(tutorial-check "05-reflection-6" [choice-test <== :selected] :odd)
(tutorial-check "05-reflection-7" [choice-test <== [:choose 8]] 4)
(tutorial-check "05-reflection-8" [choice-test <== :selected] :even)
(tutorial-check "05-reflection-9" [choice-test <== [:unless 3]] 3)
(tutorial-check "05-reflection-10" [choice-test <== :selected] :unless)
(tutorial-check "05-reflection-11" [choice-test <== [:unless 8]] nil)
(tutorial-check "05-reflection-12" [choice-test <== :selected] :unless)
:q
