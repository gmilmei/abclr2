(defun tutorial-check (name actual expected)
  (if (equal actual expected)
      (format t "~&CHECK-PASS ~A~%" name)
      (error "CHECK-FAIL ~A: got ~S, expected ~S" name actual expected)))
(inc "build/tutorial-tests/02-accounts" :use-source t)
(tutorial-check "02-accounts-1" [alice <== :balance] 100)
(tutorial-check "02-accounts-2" [alice <== [:deposit -1]] :invalid-amount)
(tutorial-check "02-accounts-3" [alice <== [:withdraw 101]] :rejected)
(tutorial-check "02-accounts-4" [alice <== [:transfer bob 30]] :transferred)
(tutorial-check "02-accounts-5" [alice <== :balance] 70)
(tutorial-check "02-accounts-6" [bob <== :balance] 50)
(tutorial-check "02-accounts-7" [alice <== [:transfer alice 10]] :rejected)
(tutorial-check "02-accounts-8" [bob <== [:withdraw 5]] 45)
:q
