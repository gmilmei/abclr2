(defun tutorial-check (name actual expected)
  (if (equal actual expected)
      (format t "~&CHECK-PASS ~A~%" name)
      (error "CHECK-FAIL ~A: got ~S, expected ~S" name actual expected)))
(inc "build/tutorial-tests/01-basics" :use-source t)
(tutorial-check "01-basics-1" (let ((x 7)) [:point x (+ x 1)]) '(:point 7 8))
(tutorial-check "01-basics-2" [calculator <== [:add 2 3]] 5)
(tutorial-check "01-basics-3" [calculator <== [:square 7]] 49)
(tutorial-check "01-basics-4" [counter <== :inc] 1)
(tutorial-check "01-basics-5" [counter <== [:add 4]] 5)
(tutorial-check "01-basics-6" [counter <== :get] 5)
(tutorial-check "01-basics-7" [classifier <== [:classify [:point 2 3]]] '(:point 2 3))
(tutorial-check "01-basics-8" [classifier <== [:classify [1 2 3]]] '(:nonempty 1 (2 3)))
(tutorial-check "01-basics-9" [classifier <== [:classify nil]] :empty)
(tutorial-check "01-basics-10" [classifier <== [:classify 9]] :atom)
(tutorial-check "01-basics-11" [list-sum <== [:sum [2 3 4]]] 9)
(tutorial-check "01-basics-12" [list-sum <== [:sum nil]] 0)
(tutorial-check "01-basics-13" [forwarder <== [:square 8]] 64)
:q
