
(defun reading-check (name actual expected)
  (if (equal actual expected)
      (format t "~&READING-PASS ~A~%" name)
      (error "READING-FAIL ~A got ~S expected ~S" name actual expected)))

(reading-check "arithmetic" (+ 2 (* 3 4)) 14)
(reading-check "local-binding" (let ((amount 10)) (+ amount 2)) 12)
(reading-check "quoted-symbol" 'amount 'amount)
(reading-check "quoted-list" '(a b c) '(a b c))
(reading-check "constructed-list" (list 'a 'b 'c) '(a b c))
(reading-check "keyword-data" (list :deposit 10) '(:deposit 10))
(reading-check "bracket-data" (let ((x 7)) [:point x (+ x 1)]) '(:point 7 8))
(reading-check "false-test" (if nil :yes :no) :no)
(reading-check "zero-is-true" (if 0 :yes :no) :yes)
(reading-check "empty-list" (null '()) t)
(reading-check "not" (not t) nil)
(reading-check "cons-list" (cons 'a '(b c)) '(a b c))
(reading-check "car" (car '(a b c)) 'a)
(reading-check "cdr-list" (cdr '(a b c)) '(b c))
(reading-check "dotted-pair" (cons 'd 'e) '(d . e))
(reading-check "cdr-pair" (cdr '(d . e)) 'e)
(reading-check "let-star" (let* ((x 3) (y (+ x 1))) (* x y)) 12)
(reading-check "assignment" (let ((x 3)) [x := (+ x 1)] x) 4)
(reading-check "association" (let ((bindings '((n . 3) (balance . 20)))) (cdr (assoc 'balance bindings))) 20)
(reading-check "do" (do ((n 0 (+ n 1))) ((= n 3) n) (format t "~A~%" n)) 3)
(reading-check "function-reference" (mapcar #'car '((a . 1) (b . 2))) '(a b))
(reading-check "apply-list" (apply #'+ '(1 2 3)) 6)
(reading-check "apply-keywords" (apply #'sort (list (list 2 :a) (list 1 :b)) #'< (list :key #'first)) '((1 :b) (2 :a)))
(reading-check "push-pop" (let ((items (list :a :b))) (push :new items) (list (pop items) items)) '(:new (:a :b)))
(reading-check "pushnew" (let ((items (list :a))) (pushnew :a items) items) '(:a))
(reading-check "fresh-symbols" (eq (gensym "TEMP") (gensym "TEMP")) nil)
(defun reading-aux (x &aux (y (1+ x))) y)
(reading-check "aux-local" (reading-aux 4) 5)
(reading-check "reader-condition" (list :before #+COMMENT :inactive :after) '(:before :after))
(reading-check "reader-block-comment" (list :before #| not executed |# :after) '(:before :after))
[*library-directories* := (list "@ROOT@/build/reading-tests/lib/")]
(inc "@ROOT@/build/reading-tests/examples/misc/future-ex" :use-source t)
(reading-check "original-small-tree" (let ((f (make-future))) [tree2leaves <= '((a b) (c . d)) $ f] (list (next-value f) (next-value f) (next-value f) (next-value f) (next-value f))) '(a b c d :finish))
(reading-check "original-nil-leaf" (let ((f (make-future))) [tree2leaves <= '(nil) $ f] (list (next-value f) (next-value f))) '(nil :finish))
(inc "@ROOT@/build/reading-tests/examples/misc/inherit" :use-source t)
[object bird (script (=> :has-feather? !t) (=> :can-fly? !t)) (group inherit-group)]
[object emu (script (=> :can-fly? !nil) (=> Any @ Reply from Sender (inherit Any Reply Sender bird))) (group inherit-group)]
(reading-check "bird-flight" [bird <== :can-fly?] t)
(reading-check "emu-flight" [emu <== :can-fly?] nil)
(reading-check "emu-feathers" [emu <== :has-feather?] t)
(reading-check "den-meta-roundtrip" (eq [den [meta emu]] emu) t)
(reading-check "distinct-meta-identity" (eq [meta emu] emu) nil)
[group logging-group]
[object logger-a (group logging-group) (script (=> :ping !:ok))]
[object logger-b (group logging-group) (script (=> :ping !:ok))]
(reading-check "explicit-group" (eq [group-of logger-a] logging-group) t)
(reading-check "shared-group" (eq [group-of logger-a] [group-of logger-b]) t)
(reading-check "distinct-members" (eq logger-a logger-b) nil)
(reading-check "inherit-macro" (macroexpand-1 '(inherit Any Reply Sender bird)) '(reify-args-to-meta :inherit Any Reply Sender bird))
(format t "~&READING-END~%")
:q
