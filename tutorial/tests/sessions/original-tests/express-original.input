(defun original-check (name actual expected)
 (if (equal actual expected)
   (format t "~&ORIGINAL-PASS ~A~%" name)
   (error "ORIGINAL-FAIL ~A: got ~S expected ~S" name actual expected)))
[*library-directories* := (list "@ROOT@/build/original-tests/lib/")]
(inc-lib "@ROOT@/build/original-tests/lib/express" :use-source t)
(inc "@ROOT@/build/original-tests/examples/misc/express-ex" :use-source t)
(original-check "express-finished" [test <== :start] :finished)
(format t "~&ORIGINAL-END express-original~%")
:q
