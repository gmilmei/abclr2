(defun report-check (name actual expected)
 (if (equal actual expected)
  (format t "~&REPORT-PASS ~A~%" name)
  (error "REPORT-FAIL ~A got ~S expected ~S" name actual expected)))
(inc "@ROOT@/build/report-tests/13-report" :use-source t)
(report report-subject :message nil :begin nil :end nil)
[[meta report-subject] <= [:set-reporter report-recorder]]
[report-subject <= :unmatched-probe]
(report-check "attempt-reported" (mapcar #'second [report-recorder <== :events]) '(:message :begin))
(report-check "unmatched-removed" [[meta report-subject] <== :queue] nil)
[report-subject <= [:echo 11]]
(report-check "following-arrival-only" (mapcar #'second [report-recorder <== :events]) '(:message :begin :message))
(report-check "following-stays-queued" (mapcar #'first [[meta report-subject] <== :queue]) '((:echo 11)))
(format t "~&REPORT-END~%")
:q
