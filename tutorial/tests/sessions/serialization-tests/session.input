(defun serial-check (name actual expected)
 (if (equal actual expected)
  (format t "~&SERIAL-PASS ~A~%" name)
  (error "SERIAL-FAIL ~A got ~S expected ~S" name actual expected)))
; These macros must exist before translation, not merely before loading.
(defmacro serialization-change ()
 (let ((temporary (make-symbol "MODE")))
  `(let ((,temporary :local))
    (bracket mode := :macro)
    (list ,temporary mode))))
(defmacro serialization-distinct ()
 (let ((outer (make-symbol "VALUE")) (inner (make-symbol "VALUE")))
  `(let ((,outer 1)) (let ((,inner 2)) (list ,outer ,inner)))))
(defmacro serialization-identity ()
 (let ((temporary (make-symbol "IDENTITY")))
  `(let ((,temporary 9)) (list ,temporary ',temporary ',temporary))))
(defun serial-identity-p (value)
 (and (= (first value) 9) (eq (second value) (third value))
      (null (symbol-package (second value)))))
[base := "@ROOT@/build/serialization-tests/state"]
(inc base :use-source t :verbose nil)
(serial-check "source-case-result" [serialization-target <== :case] :changed)
(serial-check "source-case-state" [serialization-target <== :value] :changed)
(serial-check "source-reset" [serialization-target <== :reset] :idle)
(serial-check "source-macro-hygiene" [serialization-target <== :macro] '(:local :macro))
(serial-check "source-distinct-symbols" [serialization-target <== :distinct] '(1 2))
(serial-check "source-shared-uninterned-identity" (serial-identity-p [serialization-target <== :identity]) t)
; Guarantee inc really chooses the compiled artifact, even on second-resolution clocks.
(sleep 1.1)
(compile-file (r2sys::complete-lisp-filename base) :output-file (r2sys::complete-fasl-filename base))
(serial-check "fasl-strictly-newer" (> (file-write-date (r2sys::complete-fasl-filename base)) (file-write-date (r2sys::complete-lisp-filename base))) t)
(inc base :verbose nil)
(serial-check "compiled-case-result" [serialization-target <== :case] :changed)
(serial-check "compiled-case-state" [serialization-target <== :value] :changed)
(serial-check "compiled-reset" [serialization-target <== :reset] :idle)
(serial-check "compiled-macro-hygiene" [serialization-target <== :macro] '(:local :macro))
(serial-check "compiled-distinct-symbols" [serialization-target <== :distinct] '(1 2))
(serial-check "compiled-shared-uninterned-identity" (serial-identity-p [serialization-target <== :identity]) t)
(format t "~&SERIAL-END~%")
:q
