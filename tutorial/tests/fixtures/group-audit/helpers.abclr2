; Host-side diagnostics only: no state writes, no forced meta-level creation.
(defun group-check (name actual expected)
 (if (equal actual expected)
  (format t "~&GROUP-PASS ~A~%" name)
  (error "GROUP-FAIL ~A got ~S expected ~S" name actual expected)))
(defun group-check-point (name object expected)
 (let ((visible (r2sys::state-list (r2sys::meta-of object))))
  (group-check (list name :identity) (r2sys::group-of object) expected)
  (group-check (list name :group-state) (cdr (assoc 'Group visible)) expected)
  (group-check (list name :execution-state) (cdr (assoc 'Group-manager visible)) expected)))
(defun group-context (name actual expected)
 (unless (eq actual expected) (error "GROUP-FAIL context ~A" name))
 (format t "~&GROUP-CONTEXT ~A~%" name))
(defun group-check-nrm (name object expected meta-group)
 (let ((meta (r2sys::meta-of object)))
  (group-check (list name :identity) (r2sys::group-of object) expected)
  (group-check (list name :meta-owner) (r2sys::group-of meta) meta-group)
  (group-check (list name :denotation) (r2sys::den-of meta) object)
  (group-check (list name :meta-link) (r2sys::meta-of (r2sys::den-of meta)) meta)
  (group-check (list name :opaque) (r2sys::state-list meta) nil)
  (group-check (list name :nrm-type)
               (r2sys::object-data-type (r2sys::object-data-meta meta)) 'r2sys::NRM)))
