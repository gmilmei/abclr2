;;;; Native SBCL test orchestration; ABCL/R2 always runs in a fresh image.
;;;; Invoke from any directory: sbcl --script tutorial/tests/run-tests.lisp SUITE.
(require :asdf)
(load (merge-pathnames "../source-views.lisp" *load-truename*))
(defpackage :abclr2-tutorial-tests (:use :cl))
(in-package :abclr2-tutorial-tests)

(defparameter *root*
  (truename (merge-pathnames "../../" (uiop:pathname-directory-pathname *load-truename*))))
(defparameter *image* (merge-pathnames "src/saved_abclr2" *root*))
(defparameter *label* "current")
(defparameter *snapshots* nil)
(defparameter *copies* nil)

(defun root-path (relative) (merge-pathnames relative *root*))
(defun bytes (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((data (make-array (file-length stream) :element-type '(unsigned-byte 8))))
      (assert (= (length data) (read-sequence data stream)))
      data)))
(defun text (path)
  (with-open-file (stream path :external-format :utf-8)
    (let ((out (make-string-output-stream)))
      (loop for char = (read-char stream nil) while char do (write-char char out))
      (get-output-stream-string out))))
(defun write-text (path value)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :supersede
                               :external-format :utf-8)
    (write-string value stream)))
(defun replace-text (text old new)
  (assert (plusp (length old)))
  (with-output-to-string (out)
    (loop with start = 0 for end = (search old text :start2 start) do
      (write-string text out :start start :end end)
      (unless end (return))
      (write-string new out)
      (setf start (+ end (length old))))))
(defun occurrences (needle haystack)
  (loop with start = 0 for at = (search needle haystack :start2 start)
        while at count at do (setf start (+ at (length needle)))))
(defun between (value first last)
  (let* ((a (search first value))
         (start (if a (+ a (length first)) 0))
         (b (search last value :start2 start)))
    (subseq value start b)))
(defun files-under (directory)
  (append (uiop:directory-files directory)
          (mapcan #'files-under (uiop:subdirectories directory))))
(defun snapshot-sources ()
  (setf *snapshots*
        (loop for directory in '("examples/" "lib/" "tutorial/examples/")
              append (loop for path in (files-under (root-path directory))
                           when (equal (pathname-type path) "abclr2")
                             collect (cons path (bytes path))))))
(defun check-integrity ()
  ;; Direct byte comparison is stronger than comparing digests and needs no
  ;; cryptography library. Check copied originals as well as the source tree.
  (dolist (entry (append *snapshots* *copies*))
    (assert (equalp (cdr entry) (bytes (car entry))) ()
            "Source integrity check failed: ~A" (car entry))))
(defun copy-source (source destination)
  (let ((from (root-path source)) (to (root-path destination)))
    (ensure-directories-exist to)
    (uiop:copy-file from to)
    (push (cons to (bytes from)) *copies*)))
(defun copy-source-tree (source destination &optional original-p)
  (let ((from (root-path source)))
    (dolist (path (files-under from))
      (unless (equal (pathname-type path) "lsp")
        (let ((relative (enough-namestring path *root*))
              (to (concatenate 'string destination (enough-namestring path from))))
          (if (and original-p (equal (pathname-type path) "abclr2"))
              (progn
                (write-text (root-path to)
                            (abclr2-source-views:source-text path :original t))
                (push (cons (root-path to) (bytes (root-path to))) *copies*))
              (copy-source relative to)))))))
(defun remove-translations (directory)
  ;; Only generated .lsp files inside the exact suite's build directory.
  (dolist (path (files-under (root-path directory)))
    (when (equal (pathname-type path) "lsp") (delete-file path))))
(defun excerpt (source ranges)
  ;; Split only at LF, retaining original bytes/newlines, including CRLF.
  (let* ((raw (bytes (root-path source)))
         (data (if (search ";; PORT-BEGIN:" (text (root-path source)))
                   (sb-ext:string-to-octets
                    (abclr2-source-views:source-text (root-path source))
                    :external-format :utf-8)
                   raw))
         (starts (cons 0 (loop for byte across data for i from 0
                              when (= byte 10) collect (1+ i)))))
    (apply #'concatenate '(vector (unsigned-byte 8))
           (loop for (first last) in ranges collect
             (progn
               (assert (<= 1 first last (length starts)))
               (subseq data (nth (1- first) starts)
                       (or (nth last starts) (length data))))))))
(defun write-excerpt (source destination ranges)
  (let ((path (root-path destination)))
    (ensure-directories-exist path)
    (with-open-file (out path :direction :output :if-exists :supersede
                             :element-type '(unsigned-byte 8))
      (write-sequence (excerpt source ranges) out))))
(defun excerpt-text (source ranges)
  (sb-ext:octets-to-string (excerpt source ranges) :external-format :utf-8))

(defun suite-output (suite)
  (if (string= suite "parser-tests")
      (format nil "build/parser-tests/~A/" *label*)
      (format nil "build/~A/" suite)))
(defun prepare-suite (suite)
  (let ((out (suite-output suite)))
    (ensure-directories-exist (root-path (concatenate 'string out "placeholder")))
    (remove-translations out)
    (flet ((copy-flat (directory)
             (dolist (path (uiop:directory-files (root-path directory)))
               (when (equal (pathname-type path) "abclr2")
                 (copy-source (enough-namestring path *root*)
                              (concatenate 'string out (file-namestring path)))))))
      (cond
        ((string= suite "group-tests")
         (copy-source-tree "examples/" (concatenate 'string out "examples/"))
         (copy-source-tree "lib/" (concatenate 'string out "lib/"))
         (copy-source "tutorial/tests/fixtures/group-audit/helpers.abclr2"
                      (concatenate 'string out "helpers.abclr2"))
         (write-excerpt "examples/misc/reify-args.abclr2"
                        (concatenate 'string out "interrupt.abclr2") '((74 180) (188 212))))
        ((member suite '("original-tests" "parser-tests") :test #'string=)
         (copy-source-tree "examples/" (concatenate 'string out "examples/")
                           (string= suite "original-tests"))
         (copy-source-tree "lib/" (concatenate 'string out "lib/"))
         (when (string= suite "original-tests")
           (write-excerpt "examples/misc/reify-args.abclr2"
                          (concatenate 'string out "reify-first.abclr2") '((1 51)))))
        ((member suite '("timewarp-tests" "timewarp-variants" "pcontrol-tests") :test #'string=)
         (copy-flat (if (string= suite "pcontrol-tests") "examples/pcontrol/" "examples/time-warp/"))
         (when (string= suite "timewarp-variants")
           (copy-source-tree "examples/time-warp/" (concatenate 'string out "historical/")
                             t))
         (when (string= suite "timewarp-tests")
           (copy-source "tutorial/examples/08-timewarp-rollback.abclr2"
                        (concatenate 'string out "08-timewarp-rollback.abclr2"))))
        ((string= suite "reading-tests")
         (dolist (relative '("lib/future.abclr2" "examples/misc/future-ex.abclr2" "examples/misc/inherit.abclr2"))
           (copy-source relative (concatenate 'string out relative))))
        ((string= suite "reflection-tests")
         (copy-source "examples/misc/inherit.abclr2" (concatenate 'string out "inherit.abclr2"))
         (copy-source "lib/copy.abclr2" (concatenate 'string out "lib/copy.abclr2"))
         (dolist (name '("user-script" "MCP" "meta-meta"))
           (copy-source (format nil "examples/misc/~A.abclr2" name)
                        (format nil "~A~A.abclr2" out name))))
        ((string= suite "guard-tests")
         (copy-source "lib/heavy-meta.abclr2" (concatenate 'string out "lib/heavy-meta.abclr2"))
         (write-excerpt "lib/heavy-meta.abclr2" (concatenate 'string out "original-counter.abclr2") '((133 144)))
         (write-text (root-path (concatenate 'string out "09-guards.abclr2"))
                     (replace-text (text (root-path "tutorial/examples/09-guards.abclr2"))
                                   "\"lib/heavy-meta\""
                                   (format nil "~S" (namestring (root-path (concatenate 'string out "lib/heavy-meta")))))))
        ((string= suite "heavy-old-tests")
         (dolist (entry '(("legacy" "heavy-meta-old" 106 117)
                          ("current" "heavy-meta" 133 144)))
           (destructuring-bind (variant library first last) entry
             (copy-source (format nil "lib/~A.abclr2" library)
                          (format nil "~A~A/lib/~A.abclr2" out variant library))
             (write-excerpt (format nil "lib/~A.abclr2" library)
                            (format nil "~A~A/original-counter.abclr2" out variant)
                            (list (list first last))))))
        ((string= suite "interrupt-tests")
         (write-excerpt "examples/misc/reify-args.abclr2"
                        (concatenate 'string out "interrupt-excerpt.abclr2") '((74 180) (188 212))))
        ((string= suite "multicast-tests")
         (copy-source "lib/multicast.abclr2" (concatenate 'string out "lib/multicast.abclr2"))
         (write-excerpt "lib/multicast.abclr2" (concatenate 'string out "original-objects.abclr2") '((173 183)))
         (write-text (root-path (concatenate 'string out "10-multicast.abclr2"))
                     (replace-text (text (root-path "tutorial/examples/10-multicast.abclr2"))
                                   "\"lib/multicast\""
                                   (format nil "~S" (namestring (root-path (concatenate 'string out "lib/multicast")))))))
        ((string= suite "break-tests")
         (copy-source "examples/misc/break.abclr2" (concatenate 'string out "break.abclr2")))
        ((string= suite "copy-tests")
         (copy-source "lib/copy.abclr2" (concatenate 'string out "lib/copy.abclr2"))
         (write-excerpt "lib/copy.abclr2" (concatenate 'string out "original-fib.abclr2") '((164 179)))
         (write-text (root-path (concatenate 'string out "11-copy.abclr2"))
                     (replace-text (text (root-path "tutorial/examples/11-copy.abclr2"))
                                   "\"lib/copy\""
                                   (format nil "~S" (namestring (root-path (concatenate 'string out "lib/copy")))))))
        ((string= suite "retry-tests")
         (copy-source "examples/misc/fault-tolerant.abclr2" (concatenate 'string out "fault-tolerant.abclr2")))
        ((string= suite "watch-tests")
         (dolist (library '("watch" "future" "copy"))
           (copy-source (format nil "lib/~A.abclr2" library)
                        (format nil "~Alib/~A.abclr2" out library)))
         (let ((demo (text (root-path "tutorial/examples/12-watch.abclr2"))))
           (dolist (library '("watch" "future"))
             (setf demo (replace-text demo (format nil "\"lib/~A\"" library)
                                      (format nil "~S" (namestring (root-path (format nil "~Alib/~A" out library)))))))
           (write-text (root-path (concatenate 'string out "12-watch.abclr2")) demo)))
        ((string= suite "report-tests")
         (dolist (library '("copy" "report"))
           (copy-source (format nil "lib/~A.abclr2" library)
                        (format nil "~Alib/~A.abclr2" out library)))
         (let ((demo (text (root-path "tutorial/examples/13-report.abclr2"))))
           (dolist (library '("copy" "report"))
             (setf demo (replace-text demo (format nil "\"lib/~A\"" library)
                                      (format nil "~S" (namestring (root-path (format nil "~Alib/~A" out library)))))))
           (write-text (root-path (concatenate 'string out "13-report.abclr2")) demo)))
        ((string= suite "serialization-tests")
         (copy-source-tree "tutorial/tests/fixtures/serialization/" out))
        ((string= suite "loading-tests")
         (dolist (path (files-under (root-path out)))
           (when (equal (pathname-type path)
                        (pathname-type (compile-file-pathname "fixture.lsp")))
             (delete-file path)))
         (copy-source-tree "tutorial/tests/fixtures/loading/" out)
         (copy-source "tutorial/examples/15-loaded-fragment.abclr2"
                      (concatenate 'string out "context.abclr2")))
        ((string= suite "host-event-tests")
         (copy-source "tutorial/examples/14-host-events.abclr2"
                      (concatenate 'string out "14-host-events.abclr2")))
        ((string= suite "tutorial-semantics")
         (copy-source "lib/future.abclr2" (concatenate 'string out "future.abclr2")))
        ((string= suite "express-tests")
         (dolist (variant '("express" "express-old"))
           (copy-source (format nil "lib/~A.abclr2" variant)
                        (format nil "~A~A/~A.abclr2" out variant variant))
           (copy-source (format nil "examples/misc/~A-ex.abclr2" variant)
                        (format nil "~A~A/~A-ex.abclr2" out variant variant))))
        ((string= suite "tutorial-tests")
         (dolist (library '("future" "express"))
           (copy-source (format nil "lib/~A.abclr2" library) (format nil "~Alib/~A.abclr2" out library)))
         (dolist (path (uiop:directory-files (root-path "tutorial/examples/")))
           (when (equal (pathname-type path) "abclr2")
             (let ((value (text path)))
               (dolist (library '("future" "express"))
                 (setf value (replace-text value (format nil "\"lib/~A\"" library)
                                           (format nil "\"build/tutorial-tests/lib/~A\"" library))))
               (write-text (root-path (concatenate 'string out (file-namestring path))) value)))))
        (t (error "Unknown suite: ~A" suite))))))

(defun session-text (suite name)
  (let ((value (text (root-path (format nil "tutorial/tests/sessions/~A/~A.input" suite name)))))
    (setf value (replace-text value "@ROOT@" (string-right-trim "/" (namestring *root*))))
    (when (string= suite "parser-tests")
      (setf value (replace-text value "build/parser-tests/current/" (suite-output suite))))
    (when (search "@BREAK-DEFINITION@" value)
      (setf value (replace-text value "@BREAK-DEFINITION@"
                               (string-right-trim '(#\Newline)
                                 (replace-text (excerpt-text "examples/misc/break.abclr2" '((69 75)))
                                               "ABCL/R2>" "")))))
    (when (search "@GUARD-ORIGINAL-SESSION@" value)
      (setf value (replace-text value (format nil "@GUARD-ORIGINAL-SESSION@~%")
                               (excerpt-text "lib/heavy-meta.abclr2" '((146 148))))))
    (when (search "@MULTICAST-ORIGINAL-SESSION@" value)
      (setf value (replace-text value "@MULTICAST-ORIGINAL-SESSION@"
                               (excerpt-text "lib/multicast.abclr2" '((171 185))))))
    (when (search "@COPY-ORIGINAL-SESSION@" value)
      (setf value (replace-text value "@COPY-ORIGINAL-SESSION@"
                               (excerpt-text "lib/copy.abclr2" '((181 187))))))
    (when (search "@HEAVY-ORIGINAL-SESSION@" value)
      (setf value (replace-text value "@HEAVY-ORIGINAL-SESSION@"
                               (if (string= name "legacy")
                                   (excerpt-text "lib/heavy-meta-old.abclr2" '((119 121)))
                                   (excerpt-text "lib/heavy-meta.abclr2" '((146 148)))))))
    value))

(defun run-image (program input log cwd seconds &optional arguments)
  (write-text input program)
  (ensure-directories-exist log)
  (let ((process nil) (timed-out nil))
    (unwind-protect
         (progn
           (setf process (sb-ext:run-program (namestring *image*) arguments :wait nil
                         :directory cwd :input input :output log :if-output-exists :supersede :error :output))
           (let ((deadline (+ (get-internal-real-time) (* seconds internal-time-units-per-second))))
             (loop while (sb-ext:process-alive-p process) do
               (when (>= (get-internal-real-time) deadline)
                 (setf timed-out t)
                 (sb-ext:process-kill process 9)
                 (return))
               (sleep 0.05)))
           (sb-ext:process-wait process)
           (values (text log) (sb-ext:process-exit-code process) timed-out))
      (when process
        (when (sb-ext:process-alive-p process)
          (sb-ext:process-kill process 9) (sb-ext:process-wait process))
        (sb-ext:process-close process)))))

;; Case options retain the previous runners' marker counts, end markers,
;; timeouts, cwd, and extra transcript assertions. Data lives in cases.lisp.
(load (root-path "tutorial/tests/cases.lisp"))

(defun extra-checks (suite name output)
  (cond
    ((and (string= suite "express-tests") (string= name "express/active-lock"))
     (let* ((blocked (search "No return messages!" output))
            (before (subseq output 0 blocked))
            (grab (search "EXPRESS-TRACE grab" before))
            (lock (search "EXPRESS-TRACE lock-arrival" before)))
       (and blocked grab lock (< grab lock)
            (not (search "EXPRESS-TRACE lock-reply" before)))))
    ((string= suite "tutorial-tests") (not (search "unhandled condition" (string-downcase output))))
    ((and (string= suite "interrupt-tests") (string= name "session"))
     (let ((early (between output "INTERRUPT-PASS normal-body" "INTERRUPT-PASS early-interrupt"))
           (late (between output "INTERRUPT-PASS early-interrupt" "INTERRUPT-PASS late-interrupt")))
       (and (loop for i below 3 always (search (format nil "Count ~D." i) early))
            (not (search "Count 3." early))
            (loop for i below 10 always (search (format nil "Count ~D." i) late)))))
    (t t)))
(defun case-ok-p (suite name options output code timeout)
  (let* ((prefix (getf options :prefix))
         (forbidden (append (getf options :forbidden)
                            (unless (getf options :defect)
                              (append '(";An error is detected." "ABCLR2-ERROR:")
                                      (when prefix (list (concatenate 'string prefix "-FAIL"))))))))
    (and (or (getf options :defect) (getf options :observe)
             (and (not timeout) (eql code 0)))
         (or (getf options :defect) (not timeout))
         (or (null prefix) (= (occurrences (concatenate 'string prefix "-PASS ") output)
                             (getf options :count)))
         (every (lambda (item) (search item output)) (getf options :required))
         (notany (lambda (item) (search item output)) forbidden)
         (every (lambda (pair) (= (occurrences (first pair) output) (second pair)))
                (getf options :counts))
         (extra-checks suite name output))))
(defun run-suite (suite)
  (snapshot-sources)
  (unwind-protect
       (progn
         (prepare-suite suite)
         (let ((rows nil) (total 0) (failed nil))
           (dolist (case (cdr (assoc suite *suites* :test #'string=)))
             (destructuring-bind (name &rest options) case
               (let* ((base (concatenate 'string (suite-output suite) name))
                      (cwd (getf options :cwd ""))
                      (cwd (cond ((string= cwd "@OUT@") (suite-output suite))
                                 ((search "@OUT@/" cwd) (concatenate 'string (suite-output suite) (subseq cwd 6)))
                                 (t cwd))))
                 (multiple-value-bind (output code timeout)
                     (run-image (session-text suite name)
                                (root-path (concatenate 'string base ".input"))
                                (root-path (concatenate 'string base ".log"))
                                (root-path cwd) (getf options :timeout 20))
                   (let* ((prefix (getf options :prefix))
                          (count (if prefix (occurrences (concatenate 'string prefix "-PASS ") output) 0))
                          (ok (case-ok-p suite name options output code timeout))
                          (status (cond (timeout "TIMEOUT") (ok "PASS") (t "FAIL"))))
                     (when timeout (write-text (root-path (concatenate 'string base ".log"))
                                               (concatenate 'string output (format nil "~%TIMEOUT~%"))))
                     (incf total count)
                     (format t "~A: ~A~@[ (~D checks)~]~A~%" name
                             (if (and ok (getf options :defect)) "EXPECTED-FAILURE" status)
                             (and prefix count)
                             (if (getf options :defect) " [observation, not a compatibility pass]" ""))
                     (finish-output)
                     (if (getf options :observe)
                         (push (list name status (first-diagnostic output)) rows)
                         (unless ok (setf failed t) (write-string output))))))))
           (check-integrity)
           (when (string= suite "original-tests") (write-baseline (nreverse rows)))
           (format t "~A: ~D strict checks; distributed source bytes unchanged during run.~%" suite total)
           (not failed)))
    (check-integrity)))

(defun first-diagnostic (output)
  (or (find-if (lambda (line)
                 (some (lambda (item) (search item line))
                       '("is not supported" "ORIGINAL-FAIL" "is not bound" "is undefined" "unmatched close parenthesis")))
               (uiop:split-string output :separator '(#\Newline))) ""))
(defun write-baseline (rows)
  (write-text (root-path "build/original-tests/baseline.md")
    (with-output-to-string (out)
      (format out "# Original example baseline~%~%Reference tree: .~%Original example code is reconstructed from inline port notes into build/original-tests/. This is a code comparison, not a byte-exact archival export.~%Libraries use the distributed versions with their documented corrections.~%Sample invocations follow original comments/README.~%Each case runs in a fresh image with a five-second bound.~%No compatibility prelude is loaded.~%~%reify-first-excerpt contains exactly original lines 1--51.~%pcontrol and time-warp run in their copied example directories.~%~%| Original case | Result | First diagnostic |~%| --- | --- | --- |~%")
      (dolist (row rows)
        (format out "| ~A | ~A | ~A |~%" (first row) (second row) (replace-text (third row) "|" "/")))
      (format out "~%Distributed source bytes unchanged during run: True.~%~%FAIL/TIMEOUT are observations, not newly accepted semantics.~%Passing return values do not establish scheduling/preemption correctness.~%"))))

(defun main (args)
  (let ((suite (pop args)))
    (unless suite (error "Usage: run-tests.lisp SUITE [--image PATH] [--label NAME]"))
    (when (string= suite "--self-check")
      (load (root-path "tutorial/tests/check-runner.lisp"))
      (return-from main (check-runner)))
    (loop while args for option = (pop args) for value = (pop args) do
      (unless value (error "Missing value for ~A" option))
      (cond ((string= option "--image") (setf *image* (truename value)))
            ((string= option "--label")
             (unless (and (plusp (length value))
                          (or (alpha-char-p (char value 0)) (char= (char value 0) #\_))
                          (every (lambda (c) (or (alphanumericp c) (char= c #\_))) value))
               (error "--label must be an identifier"))
             (setf *label* value))
            (t (error "Unknown option: ~A" option))))
    (unless (assoc suite *suites* :test #'string=) (error "Unknown suite: ~A" suite))
    (unless (probe-file *image*) (error "Build src/saved_abclr2 with make first."))
    (run-suite suite)))

(handler-case (sb-ext:exit :code (if (main (cdr sb-ext:*posix-argv*)) 0 1))
  (error (condition) (format *error-output* "TEST-RUNNER-FAIL: ~A~%" condition) (sb-ext:exit :code 1)))
