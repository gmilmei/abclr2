;;;; Infrastructure regressions: never alter or load the historical runtime.
(defun check-runner ()
  (let ((count 0)
        (contract '(:prefix "UNIT" :count 1 :required ("UNIT-END")
                    :forbidden ("No return messages!") :counts (("record" 1))))
        (good (format nil "UNIT-PASS probe~%record~%UNIT-END~%")))
    (flet ((check (name condition)
             (assert condition () "Runner self-check failed: ~A" name)
             (incf count) (format t "RUNNER-PASS ~A~%" name)))
      (check "valid-transcript" (case-ok-p "unit" "probe" contract good 0 nil))
      (check "missing-result" (not (case-ok-p "unit" "probe" contract "UNIT-END record" 0 nil)))
      (check "duplicate-result" (not (case-ok-p "unit" "probe" contract
                                               (concatenate 'string good "UNIT-PASS duplicate") 0 nil)))
      (check "nonzero-exit" (not (case-ok-p "unit" "probe" contract good 7 nil)))
      (check "timeout-rejected" (not (case-ok-p "unit" "probe" contract good 0 t)))
      (check "missing-end" (not (case-ok-p "unit" "probe" contract "UNIT-PASS probe record" 0 nil)))
      (dolist (error '("UNIT-FAIL" ";An error is detected." "ABCLR2-ERROR:" "No return messages!"))
        (check error (not (case-ok-p "unit" "probe" contract (concatenate 'string good error) 0 nil))))
      (check "record-count" (not (case-ok-p "unit" "probe" contract
                                            (concatenate 'string good "record") 0 nil)))
      (check "defect-signature-required"
             (not (case-ok-p "unit" "probe" '(:defect t :required ("defect")) good 0 nil)))
      (check "bounded-defect-observation"
             (case-ok-p "unit" "probe" '(:defect t :required ("defect" "No return messages!"))
                        "defect No return messages!" 9 t))
      (check "case-insensitive-unhandled"
             (not (case-ok-p "tutorial-tests" "probe" contract
                              (concatenate 'string good "Unhandled Condition") 0 nil)))
      (check "literal-replacement" (string= (replace-text "a@ROOT@b@ROOT@" "@ROOT@" "/tmp") "a/tmpb/tmp"))
      (let* ((directory (root-path "build/runner-tests/"))
             (script (merge-pathnames "child.lisp" directory))
             (*image* sb-ext:*runtime-pathname*))
        (write-text script "(format t \"~&RUNNER-READY~%\") (finish-output) (sb-ext:exit :code 7)")
        (multiple-value-bind (output code timeout)
            (run-image "" (merge-pathnames "exit.input" directory) (merge-pathnames "exit.log" directory)
                       *root* 5 (list "--script" (namestring script)))
          (check "child-nonzero-and-log" (and (eql code 7) (not timeout) (search "RUNNER-READY" output))))
        (write-text script "(format t \"~&RUNNER-READY~%\") (finish-output) (sleep 30)")
        (let ((start (get-internal-real-time)))
          (multiple-value-bind (output code timeout)
              (run-image "" (merge-pathnames "timeout.input" directory) (merge-pathnames "timeout.log" directory)
                         *root* 1 (list "--script" (namestring script)))
            (declare (ignore code))
            (check "child-timeout-and-partial-log"
                   (and timeout (search "RUNNER-READY" output)
                        (< (/ (- (get-internal-real-time) start) internal-time-units-per-second) 5)))))
        (let* ((copy (merge-pathnames "integrity.txt" directory))
               (*snapshots* nil) (*copies* nil))
          (write-text copy "before")
          (setf *copies* (list (cons copy (bytes copy))))
          (check "unchanged-copy" (progn (check-integrity) t))
          (write-text copy "after")
          (check "changed-copy-rejected" (handler-case (progn (check-integrity) nil) (error () t))))
        (let ((path (merge-pathnames "excerpt.abclr2" directory)))
          (write-text path (format nil "one~C~%two~C~%three" #\Return #\Return))
          (check "excerpt-keeps-crlf" (string= (excerpt-text (namestring path) '((2 2))) (format nil "two~C~%" #\Return)))
          (check "excerpt-no-final-newline" (string= (excerpt-text (namestring path) '((3 3))) "three")))))
    (format t "~D runner infrastructure checks passed.~%" count)
    t))
