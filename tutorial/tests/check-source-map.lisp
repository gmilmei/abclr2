;;;; Structural inventory check, not a semantic or pedagogical certification.
(require :asdf)
(let* ((root (truename (merge-pathnames "../../" (uiop:pathname-directory-pathname *load-truename*))))
       (map-path (merge-pathnames "tutorial/chapters/source-map.tex" root))
       (paths nil) (targets nil))
 (labels ((read-text (path)
            (with-open-file (in path :external-format :utf-8)
              (let ((data (make-string (file-length in))))
                (subseq data 0 (read-sequence data in)))))
          (sources (directory)
            (append (remove-if-not (lambda (p) (equal (pathname-type p) "abclr2"))
                                   (uiop:directory-files directory))
                    (mapcan #'sources (uiop:subdirectories directory))))
          (field (line start)
            (assert (char= (char line start) #\{))
            (let ((end (position #\} line :start (1+ start))))
              (assert end)
              (values (subseq line (1+ start) end) (1+ end)))))
  (with-open-file (in map-path :external-format :utf-8)
   (loop for line = (read-line in nil) while line do
    (when (uiop:string-prefix-p "\\sourcefile{" line)
     (multiple-value-bind (path next) (field line (length "\\sourcefile"))
      (multiple-value-bind (target end) (field line next)
       (declare (ignore end))
       (push path paths) (push target targets))))))
  (assert (= (length paths) (length (remove-duplicates paths :test #'string=)))
          () "Duplicate source-map entry.")
  (let* ((expected (mapcar (lambda (p) (enough-namestring p root))
                          (append (sources (merge-pathnames "examples/" root))
                                  (sources (merge-pathnames "lib/" root)))))
         (missing (set-difference expected paths :test #'string=))
         (extra (set-difference paths expected :test #'string=))
         (tex (apply #'concatenate 'string
                     (mapcar #'read-text
                       (cons (merge-pathnames "tutorial/tutorial.tex" root)
                             (uiop:directory-files (merge-pathnames "tutorial/chapters/" root) "*.tex"))))))
   (assert (not missing) () "Unmapped original sources: ~S" missing)
   (assert (not extra) () "Non-original or missing sources in map: ~S" extra)
   (dolist (target targets)
    (assert (search (format nil "\\label{~A}" target) tex) ()
            "Missing reading-section label: ~A" target))
   (format t "SOURCE-MAP-PASS ~D original examples and ~D libraries; ~D unique entries and section targets checked.~%"
           (count-if (lambda (p) (uiop:string-prefix-p "examples/" p)) paths)
           (count-if (lambda (p) (uiop:string-prefix-p "lib/" p)) paths)
           (length paths)))))
