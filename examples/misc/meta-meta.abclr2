;;; Example of a user defined meta-meta object.

;;; 1. Create a meta-meta object generator at the meta-meta-level.
[object the-meta-meta-gen
  (group (group-of (group-of group)))	; ***
  (script
   (=> [:new StateSpec LexEnv Scripts Eval GMgr . Extra] @ R
       [object Metaobject
	 (state [queue := [queue-gen <== :new]]
		[state := nil]
		[scriptSet := scripts]
		[evaluator := Eval]
;; PORT-BEGIN: Expose ownership as Group; retain Group-manager for execution.
;;|		[Group-manager := GMgr]
;; PORT-ACTIVE
		[Group-manager := GMgr] [Group := GMgr]
;; PORT-END
		[mode := ':dormant]) 
	 (script
	  (=> [:message Message Reply Sender]
	      (format t "~&Meta-meta receievs message ~A." message)
	      [queue <= [:enq [Message Reply Sender]]]
	      (when (eq mode ':dormant)
		[mode := ':active]
		[Me <= :begin]))
	  (=> :begin
	      (match [queue <== :deq]
		(is [Message Reply Sender]
		    (match (find-script Message Reply Sender scriptSet)
		      (is [Bindings ScriptBody]
			  [evaluator 
			   <= [:do
			       ScriptBody [env-gen <== [:new Bindings state]]
			       Me Group-manager evaluator]
			   @ [cont _
				   [Me <= :end]]])
		      (otherwise
		       (warn "~S cannot handle the message ~S"
			     [den Me] Message))))))
	  (=> :end
	      (if (not [queue <== :empty?])
		  [Me <= :begin]
		  [mode := ':dormant]))
	  ;; reflective operations
	  (=> :state !state)
	  (=> [:set-state s]
	      [state := s])
	  (=> :queue @ R
	      [queue <= :listify @ R])
	  (=> :dequeue @ R
	      [queue <= :deq @ R])
	  (=> [:enqueue item]
	      [queue <= [:enq item]])
	  (=> :scripts !scriptSet)
	  (=> [:find-script Message]
	      !(search-script Message nil nil scriptSet))
	  (=> [:add-script new-script]
	      [scriptSet := (cons new-script ScriptSet)])
	  (=> [:remove-script Message]
	      [scriptSet := (remove-script Message nil nil ScriptSet)])
	  (=> :evaluator !evaluator)
	  (=> [:set-evaluator e] [evaluator := e])
	  )]
       ;; initialize state variables
       [Eval <= [:do-evlis (stateSpec-initforms StateSpec)
		  LexEnv Metaobject GMgr Eval]
	     @ [cont initValues
		     [Metaobject
		      <= [:set-state
			  [env-gen 
			   <== [:new (pairlis (stateSpec-varNames stateSpec)
					      initValues)
				     LexEnv]]]]
		     [R <= Metaobject]]]))]

;;; 2. Create a meta-object generator at the meta-level.
;;; This object creates a meta-object whose meta-object (i.e., meta-meta
;;; object) is generated by the-meta-meta-gen.
[object the-meta-gen
  (group (group-of group))		; ***
  (script
   (=> [:new StateSpec LexEnv Scripts Eval GMgr . Extra] @ R
       [object Metaobject
	 (meta-gen the-meta-meta-gen)	; ***
	 (state [queue := [queue-gen <== :new]]
		[state := nil]
		[scriptSet := scripts]
		[evaluator := Eval]
;; PORT-BEGIN: Expose ownership as Group; retain Group-manager for execution.
;;|		[Group-manager := GMgr]
;; PORT-ACTIVE
		[Group-manager := GMgr] [Group := GMgr]
;; PORT-END
		[mode := ':dormant]) 
	 (script
	  (=> [:message Message Reply Sender]
	      (format t "~&Meta-gen receievs message ~A." message)
	      [queue <= [:enq [Message Reply Sender]]]
	      (when (eq mode ':dormant)
		[mode := ':active]
		[Me <= :begin]))
	  (=> :begin
	      (match [queue <== :deq]
		(is [Message Reply Sender]
		    (match (find-script Message Reply Sender scriptSet)
		      (is [Bindings ScriptBody]
			  [evaluator 
			   <= [:do
			       ScriptBody [env-gen <== [:new Bindings state]]
			       Me Group-manager evaluator]
			   @ [cont _
				   [Me <= :end]]])
		      (otherwise
		       (warn "~S cannot handle the message ~S"
			     [den Me] Message))))))
	  (=> :end
	      (if (not [queue <== :empty?])
		  [Me <= :begin]
		  [mode := ':dormant]))
	  ;; reflective operations
	  (=> :state !state)
	  (=> [:set-state s]
	      [state := s])
	  (=> :queue @ R
	      [queue <= :listify @ R])
	  (=> :dequeue @ R
	      [queue <= :deq @ R])
	  (=> [:enqueue item]
	      [queue <= [:enq item]])
	  (=> :scripts !scriptSet)
	  (=> [:find-script Message]
	      !(search-script Message nil nil scriptSet))
	  (=> [:add-script new-script]
	      [scriptSet := (cons new-script ScriptSet)])
	  (=> [:remove-script Message]
	      [scriptSet := (remove-script Message nil nil ScriptSet)])
	  (=> :evaluator !evaluator)
	  (=> [:set-evaluator e] [evaluator := e])
	  )]
       ;; initialize state variables
       [Eval <= [:do-evlis (stateSpec-initforms StateSpec)
		  LexEnv Metaobject GMgr Eval]
	     @ [cont initValues
		     [Metaobject
		      <= [:set-state
			  [env-gen 
			   <== [:new (pairlis (stateSpec-varNames stateSpec)
					      initValues)
				     LexEnv]]]]
		     [R <= Metaobject]]]))]

;;; 3. Create a group whose meta-object generator is the-meta-gen.
[group a-group
  (meta-gen the-meta-gen)]

;;; 4. Create an object in a-group.
[object twice
  (group a-group)
  (script (=> x !(+ x x)))]

#|
;;; Sample session:
;;; Create an object in a-group 
ABCL/R2> [object twice
          (group a-group)
          (script (=> x !(+ x x)))]
ABCLR2-WARN:foo is bound to global
Meta-meta receievs message (set-state #<state-24>).
#<foo-25>
ABCL/R2>[foo <== 123]
Meta-meta receievs message (message 123 #<cont-26> #<toplevel-5>).
Meta receievs message 123.
Meta-meta receievs message begin.
Meta-meta receievs message end.
246
ABCL/R2>
|#
